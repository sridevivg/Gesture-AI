# ==============================================================================
# Gesture-AI Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/v1/ws/gesture-stream

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gesture_admin
POSTGRES_PASSWORD=gesture_secure_password
POSTGRES_DB=gesture_ai
DATABASE_URL=postgresql+asyncpg://gesture_admin:gesture_secure_password@localhost:5432/gesture_ai

# Redis Cache and Event Bus
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Machine Learning Service Configuration
ML_SERVICE_HOST=localhost
ML_SERVICE_PORT=8001
ML_MODELS_DIR=ml/models
ML_DATASETS_DIR=ml/datasets
CONFIDENCE_THRESHOLD=0.80
DETECTION_FPS=30

# System Automation & Action Execution Safety
ENABLE_SYSTEM_ACTIONS=false
ACTION_EXECUTION_COOLDOWN_SECONDS=1.0
SAFETY_FAILSAFE_ENABLED=true
