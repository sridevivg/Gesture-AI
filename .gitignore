# Git ignore rules for Gesture-AI monorepo

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment variables & local secrets
.env
.env.*
!.env.example
.env.local
.env.*.local
*.env
!*.env.example

# Node / Frontend
node_modules/
dist/
build/
.npm
.yarn/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# Python / Backend & ML
__pycache__/
pycache/
*.pyc
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Linters & Formatters
.ruff_cache/
.mypy_cache/

# Machine Learning Artifacts & Datasets
ml/datasets/*
!ml/datasets/.gitkeep
ml/models/*
!ml/models/.gitkeep
*.pt
*.pth
*.onnx
*.pkl
*.joblib
*.h5

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Docker / Temporary runtime
*.pid
tmp/
scratch/
