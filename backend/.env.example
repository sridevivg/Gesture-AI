# Backend Service Environment Variables
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://gesture_admin:gesture_secure_password@localhost:5432/gesture_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# ML Service Connection
ML_SERVICE_URL=http://localhost:8001

# Action Execution Safety Settings
ENABLE_SYSTEM_ACTIONS=false
ACTION_EXECUTION_COOLDOWN_SECONDS=1.0
SAFETY_FAILSAFE_ENABLED=true
